# Copiar a .env (que está en .gitignore) y ajustar.

# --- Invocación de Compose --------------------------------------------------
# Fija los archivos que Compose combina, para no tener que recordar los -f.
# Con esto, un simple `docker compose up -d` levanta con GPU y con la red de
# Ollama. Quitar docker-compose.gpu.yml en máquinas sin GPU NVIDIA.
#
# OJO: si una de las rutas listadas no existe, `docker compose` falla en seco.
# docker-compose.override.yml NO viene en el repo — es específico de cada
# máquina. Créalo o quítalo de esta lista. (Sin COMPOSE_FILE, Compose ya carga
# docker-compose.override.yml solo cuando existe.)
COMPOSE_FILE=docker-compose.yml:docker-compose.override.yml:docker-compose.gpu.yml

# --- Interfaz web -----------------------------------------------------------
PORT=8000
# La app NO tiene autenticación. Por eso docker-compose la publica solo en
# 127.0.0.1: para exponerla, usa un proxy inverso delante.

# Trabajos simultáneos. Con Marker dejar en 1: un documento ya satura la
# GPU/CPU y dos en paralelo solo se estorban.
WORKERS=1
MAX_UPLOAD_MB=500
RETENTION_DAYS=14

# --- Marker -----------------------------------------------------------------
# Vacío = marker elige por dispositivo (fast en CPU, balanced en GPU).
# OJO: "balanced" requiere el binario llama-server, que solo se compila con
# WITH_LLAMA_SERVER=true (ver Dockerfile). Si la imagen se construyó con el
# default (false), dejarlo vacío en GPU haría que marker eligiera balanced y
# fallara. El pipeline detecta la ausencia del binario y cae a "fast" solo,
# pero fijarlo aquí lo hace explícito y no depende de esa red de seguridad.
MARKER_MODE=fast
MARKER_TIMEOUT_S=14400

# --- Captioning de imágenes (opcional) --------------------------------------
# "ollama"    -> modelo local. Las imágenes NO salen del servidor. (default)
# "anthropic" -> API de Claude: más rápido y mejor, pero cada imagen viaja a un
#                tercero. No usar con documentos sensibles.
CAPTION_BACKEND=ollama

# Sin definir = se usa el valor del docker-compose (http://ollama:11434, por la
# red ollama-net). Desde dentro del contenedor "localhost" es el propio
# contenedor, nunca el servidor:
#   http://ollama:11434                -> Ollama es otro contenedor. Hay que
#                                         compartir su red (ver docker-compose:
#                                         networks.ollama-net). Usa el puerto
#                                         INTERNO, no el publicado en el host.
#   http://host.docker.internal:11434  -> Ollama corre en el host (requiere
#                                         OLLAMA_HOST=0.0.0.0 en su systemd).
#   http://IP-de-otra-maquina:11434    -> Ollama en otro servidor.
# OLLAMA_HOST=

CAPTION_MODEL=qwen3-vl:32b
OLLAMA_TIMEOUT_S=300

# Ollama atiende de a una salvo que se configure OLLAMA_NUM_PARALLEL: subir
# esto puede no acelerar nada. Empezar en 1 y subir con mediciones.
CAPTION_WORKERS=1

# Solo si CAPTION_BACKEND=anthropic
ANTHROPIC_API_KEY=
