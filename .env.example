# Copiar a .env (que está en .gitignore) y ajustar.

# --- Interfaz web -----------------------------------------------------------
PORT=8000
# La app NO tiene autenticación. Por eso docker-compose la publica solo en
# 127.0.0.1: para exponerla, usa un proxy inverso delante.

# Trabajos simultáneos. Con Marker dejar en 1: un documento ya satura la
# GPU/CPU y dos en paralelo solo se estorban.
WORKERS=1
MAX_UPLOAD_MB=500
RETENTION_DAYS=14

# --- Marker -----------------------------------------------------------------
# Vacío = marker elige por dispositivo (fast en CPU, balanced en GPU).
# "balanced" requiere el binario llama-server (ver Dockerfile, WITH_LLAMA_SERVER).
MARKER_MODE=
MARKER_TIMEOUT_S=14400

# --- Captioning de imágenes (opcional) --------------------------------------
# Cada imagen se envía a la API de Claude. Dejar vacío si los documentos son
# sensibles: sin esta clave el paso se deshabilita solo.
ANTHROPIC_API_KEY=
CAPTION_MODEL=claude-sonnet-5
CAPTION_WORKERS=8
