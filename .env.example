# Copiar a .env (que está en .gitignore) y ajustar.

# --- Qué ficheros compone docker compose -------------------------------------
# Descomentar SOLO en un servidor con GPU NVIDIA.
#
# Compose auto-carga docker-compose.override.yml únicamente si no pasas ningún
# -f. En cuanto ejecutas `-f docker-compose.yml -f docker-compose.gpu.yml`, el
# override deja de cargarse; y si arrancas sin -f para conservarlo, el fichero
# de GPU no se aplica y todo corre en CPU sin avisar. COMPOSE_FILE une los tres,
# y el comando de arranque vuelve a ser `docker compose up -d`, sin -f.
# COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml:docker-compose.override.yml

# --- Interfaz web -----------------------------------------------------------
PORT=8000
# La app NO tiene autenticación. Por eso docker-compose la publica solo en
# 127.0.0.1: para exponerla, usa un proxy inverso delante.

# Trabajos simultáneos. Con Marker dejar en 1: un documento ya satura la
# GPU/CPU y dos en paralelo solo se estorban.
WORKERS=1
MAX_UPLOAD_MB=500
RETENTION_DAYS=14
# Cada cuántas horas se revisan y borran los trabajos caducados (0 = solo al arrancar).
PURGE_INTERVAL_H=6

# --- Marker -----------------------------------------------------------------
# Vacío = marker elige por dispositivo (fast en CPU, balanced en GPU).
# "balanced" requiere el binario llama-server (ver Dockerfile, WITH_LLAMA_SERVER).
MARKER_MODE=
MARKER_TIMEOUT_S=14400
# Modo auto: un PDF mayormente nativo con páginas escaneadas va a Marker si
# tiene >= MIN_PAGINAS escaneadas o >= MIN_RATIO de ellas. 1 = no perder nada.
# DOC2MD_MIXTO_MIN_PAGINAS=2
# DOC2MD_MIXTO_MIN_RATIO=0.10
# DOC2MD_COBERTURA_ESCANEO=0.5
# En servidor con GPU: compila llama-server con CUDA (necesario para
# `balanced`) para la arquitectura indicada. 75 = Turing (Quadro RTX 8000,
# RTX 20xx, T4); 80 = A100; 86 = RTX 30xx/A6000; 89 = RTX 40xx/L4.
# WITH_LLAMA_SERVER=true
# CUDA_ARCHITECTURES=75

# --- Captioning de imágenes (opcional) --------------------------------------
# "ollama"    -> modelo local. Las imágenes NO salen del servidor. (default)
# "anthropic" -> API de Claude: más rápido y mejor, pero cada imagen viaja a un
#                tercero. No usar con documentos sensibles.
CAPTION_BACKEND=ollama

# Dentro de Docker, host.docker.internal apunta al servidor anfitrión.
# Si Ollama corriera en otra máquina: http://ip-de-esa-maquina:11434
OLLAMA_HOST=http://host.docker.internal:11434
CAPTION_MODEL=qwen3-vl:32b
OLLAMA_TIMEOUT_S=300
# Ollama atiende de a una: subir esto no acelera y puede agotar la VRAM.
CAPTION_WORKERS=1
# Lado menor por debajo del cual una imagen no se describe (iconos, filetes),
# y lado máximo al que se reduce antes de enviarla al modelo. 0 = desactivar.
CAPTION_MIN_PX=64
CAPTION_MAX_PX=1024

# Solo si CAPTION_BACKEND=anthropic
ANTHROPIC_API_KEY=
