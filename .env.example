# Copiar a .env (que está en .gitignore) y ajustar.

# --- Interfaz web -----------------------------------------------------------
PORT=8000
# La app NO tiene autenticación. Por eso docker-compose la publica solo en
# 127.0.0.1: para exponerla, usa un proxy inverso delante.

# Trabajos simultáneos. Con Marker dejar en 1: un documento ya satura la
# GPU/CPU y dos en paralelo solo se estorban.
WORKERS=1
MAX_UPLOAD_MB=500
RETENTION_DAYS=14

# --- Marker -----------------------------------------------------------------
# Vacío = marker elige por dispositivo (fast en CPU, balanced en GPU).
# "balanced" requiere el binario llama-server (ver Dockerfile, WITH_LLAMA_SERVER).
MARKER_MODE=
MARKER_TIMEOUT_S=14400

# --- Captioning de imágenes (opcional) --------------------------------------
# "ollama"    -> modelo local. Las imágenes NO salen del servidor. (default)
# "anthropic" -> API de Claude: más rápido y mejor, pero cada imagen viaja a un
#                tercero. No usar con documentos sensibles.
CAPTION_BACKEND=ollama

# Desde dentro del contenedor, "localhost" es el propio contenedor. Según
# dónde viva Ollama:
#   http://ollama:11434                -> Ollama es otro contenedor. Hay que
#                                         compartir su red (ver docker-compose:
#                                         networks.ollama-net). Usa el puerto
#                                         INTERNO, no el publicado en el host.
#   http://host.docker.internal:11434  -> Ollama corre en el host (requiere
#                                         OLLAMA_HOST=0.0.0.0 en su systemd).
#   http://IP-de-otra-maquina:11434    -> Ollama en otro servidor.
OLLAMA_HOST=http://ollama:11434
CAPTION_MODEL=qwen3-vl:32b
OLLAMA_TIMEOUT_S=300
# Ollama atiende de a una: subir esto no acelera y puede agotar la VRAM.
CAPTION_WORKERS=1

# Solo si CAPTION_BACKEND=anthropic
ANTHROPIC_API_KEY=
